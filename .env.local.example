# ====================================================================
# Firebase client config (Task 2 — Landing Page + Google Auth)
# ====================================================================
# 1. Go to https://console.firebase.google.com/ → create project (Blaze plan).
# 2. Add a Web App (</> icon) → copy these 4 values.
# 3. Authentication → Sign-in method → enable Google provider.
# 4. Copy this file to `.env.local` and paste the real values.
# 5. NEVER commit `.env.local`. It is gitignored.
#
# All values are NEXT_PUBLIC_* because the Firebase client SDK runs in the
# browser. These are NOT secrets — Firebase public config is safe to expose.
# Real security lives in Firestore Security Rules (see firestore.rules).

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ====================================================================
# Task 3 — Payment Backend & Credit System (bKash manual verification)
# ====================================================================
# These are SERVER-SIDE secrets (no NEXT_PUBLIC_ prefix unless noted).
# Get the service account from:
#   Firebase Console → Project Settings → Service accounts → Generate new private key.
# Copy the private_key AS-IS (it spans multiple lines). When pasting into
# .env.local, keep the "\n" escapes — the admin SDK restores real newlines.
#
# NEVER commit your real private key. .env.local is gitignored.

# Server-only service account (firebase-admin).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Admin allowlist — comma-separated Firebase uids that may approve payments.
# Find your uid: Firebase Console → Authentication → Users → copy the UID.
ADMIN_UIDS=uid1,uid2

# bKash merchant number users send 50 BDT to.
BKASH_NUMBER=01XXXXXXXXX
# Same number, NEXT_PUBLIC_ so the purchase page can render it.
NEXT_PUBLIC_BKASH_NUMBER=01XXXXXXXXX

# Per-attempt price in BDT (server is source of truth).
MODULE_PRICE=50

# ====================================================================
# Speaking module — audio transcription (Whisper)
# ====================================================================
# Server-only secret. Get it from https://platform.openai.com/api-keys.
# Used by the submit Route Handler to transcribe speaking audios via the
# whisper-1 API. If unset, speaking attempts still finalize but transcripts
# stay empty (the deterministic grade still lands).

OPENAI_API_KEY=sk-...

# Optional: override the default Storage bucket name. Defaults to
# "<FIREBASE_PROJECT_ID>.appspot.com". Set this only if your project uses a
# different bucket.
# FIREBASE_STORAGE_BUCKET=your-bucket.appspot.com
